# 🟥 [SECRET] Variables d'Environnement - EXEMPLE PUBLIC
# ⚠️ NE JAMAIS COMMITER CE FICHIER AVEC DES VRAIES VALEURS.
# Copiez ce fichier en .env et remplissez-le localement.

# 🟦 [DB] Configuration Base de Données (Souveraine)
# Le mot de passe doit faire min. 16 caractères (Checké par le script de déploiement)
DB_USER=ced_admin
DB_PASS=CHANGE_ME_TO_A_STRONG_SECRET_123!

# 🟦 [APP] Configuration Application
ENV=production
ETHICS_MODE=strict

# 🟦 [INFRA] Configuration Serveur (Infomaniak)
SERVER_REGION=ch-gva-2
BACKUP_ENABLED=true

# 🤲 [NIYYAH] Rappel
